+    # LOCAL PATCH (see build_gmp.sh.orig for upstream). Two changes:
+    #  1. An existing archive that already verifies is reused instead of being
+    #     re-downloaded and clobbered.
+    #  2. The checksum is verified INSIDE the mirror loop, so a corrupt response from
+    #     the first mirror falls through to the next one. Upstream verifies only after
+    #     the loop has already broken on the first successful transfer, which turns a
+    #     bad mirror into a hard build failure with the good mirrors never tried.
+    if [ -f ${GMP_ARCHIVE} ] && verify_checksum > /dev/null 2>&1; then
+        echo "Reusing verified ${GMP_ARCHIVE}"
+    else
