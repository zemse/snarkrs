node_modules/
.svelte-kit/
build/
# Produced by scripts/build-wasm.sh from crates/g16-wasm. Around 1 MB of binary that is
# fully reproducible from the workspace, so it is built rather than committed.
static/pkg/
# Written by that same script: the built wasm's content hash, stamped into the bundle so a
# new prover is a new URL. Generated, so not committed.
src/lib/pkg-version.ts
.vercel
.env*

# A self-signed certificate for serving this machine over https to a phone on the same
# Wi-Fi. Local, disposable, and a private key: never committed. See vite.config.ts.
.certs/

# Generated by `cargo run -p g16-wgpu --example dump_points_wgsl -- g1|g2`, for the debug
# pages beside them. Reproducible from the workspace, so built rather than committed.
static/dbg/*.wgsl
